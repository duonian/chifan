/* ===== 我的厨房 ===== */

.k-head {
  background: linear-gradient(135deg, #B85C38, #9A4E2E);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 6rpx 22rpx rgba(150, 80, 50, 0.18);
}
.k-title { font-size: 38rpx; font-weight: 700; }
.k-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

/* 适配度徽章（与食谱页一致） */
.suit {
  flex-shrink: 0;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-weight: 600;
  white-space: nowrap;
}
.suit-best { background: #E4F0E7; color: #35704A; }
.suit-good { background: #EAF1E9; color: #4E7A56; }
.suit-normal { background: #FAF0DE; color: #93702C; }
.suit-avoid { background: #FAE7E3; color: #B24C3C; }

/* 常吃菜 / 结果列表项 */
.k-list { display: flex; flex-direction: column; }
.k-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0EAE0;
}
.k-item:last-child { border-bottom: none; }
.k-name { font-size: 28rpx; font-weight: 500; color: #2E2822; }
.k-meta { font-size: 22rpx; color: #9A9086; margin-top: 4rpx; }
.k-del {
  margin-left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F1EBE1;
  color: #B8503F;
  font-size: 32rpx;
  text-align: center;
  line-height: 46rpx;
  flex-shrink: 0;
}

/* 现有食材 chips */
.inv-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 100rpx;
  background: #EAF1E9;
  color: #4E7A56;
  font-size: 25rpx;
  margin: 0 14rpx 14rpx 0;
}
.inv-x { margin-left: 10rpx; font-weight: 700; opacity: 0.7; }

/* 输入行（与「我的」同款） */
.add-row { display: flex; align-items: center; margin-top: 16rpx; }
.add-input {
  flex: 1;
  height: 72rpx;
  background: #F5F1EA;
  border-radius: 100rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.suggest-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  background: #F1EBE1;
  color: #7A6F62;
  font-size: 23rpx;
  margin: 0 12rpx 12rpx 0;
}
.suggest-chip.on { background: #EAF1E9; color: #4E7A56; text-decoration: line-through; }

/* 需要采购 */
.buy-box {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E0D6C8;
}
.buy-title { font-size: 24rpx; color: #B85C38; font-weight: 600; margin-bottom: 10rpx; }
.buy-chip {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 100rpx;
  background: #FBF3E6;
  color: #9A6A28;
  font-size: 23rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 添加菜品弹层 */
.picker-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(40, 32, 24, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.picker {
  width: 100%;
  background: #FFFDFA;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}
.picker-head { display: flex; align-items: center; justify-content: space-between; }
.picker-close { font-size: 40rpx; color: #9A9086; line-height: 1; padding: 0 10rpx; }
.picker-list { flex: 1; margin-top: 16rpx; }
.picker-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0EAE0;
}
.picker-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #B85C38;
  color: #fff;
  font-size: 36rpx;
  text-align: center;
  line-height: 54rpx;
  flex-shrink: 0;
}
