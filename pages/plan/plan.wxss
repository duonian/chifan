.topbar {
  display: flex;
  align-items: center;
  background: #FFFDFA;
  border-radius: 22rpx;
  padding: 20rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 100, 80, 0.05);
}
.date-nav {
  width: 80rpx;
  text-align: center;
  font-size: 44rpx;
  color: #B0A697;
}
.date-center { flex: 1; text-align: center; }
.date-main { font-size: 30rpx; font-weight: 600; }
.date-sub { font-size: 22rpx; color: #A2988B; margin-top: 4rpx; }

.gen-card { padding: 60rpx 40rpx; }
.gen-emoji { font-size: 90rpx; text-align: center; margin-bottom: 20rpx; }

/* 营养 */
.nutri-card { display: flex; padding: 26rpx 10rpx; }
.nutri-item { flex: 1; text-align: center; }
.nutri-num { font-size: 36rpx; font-weight: 700; color: #3A342D; }
.nutri-num .unit { font-size: 22rpx; font-weight: 400; margin-left: 2rpx; }
.nutri-num.warn { color: #C0504D; }
.nutri-num.mid { color: #D99441; }
.nutri-num.ok { color: #4A7C59; }
.nutri-label { font-size: 21rpx; color: #A2988B; margin-top: 6rpx; }

/* 餐次 */
.meal-block { margin-bottom: 30rpx; }
.meal-head {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 16rpx;
}
.meal-icon { font-size: 34rpx; margin-right: 12rpx; }
.meal-name { font-size: 32rpx; font-weight: 700; }
.meal-time { margin-left: auto; font-size: 22rpx; color: #A2988B; }

/* 菜品卡片 */
.dish-card {
  background: #FFFDFA;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 100, 80, 0.05);
}
.dish-top { display: flex; align-items: flex-start; }
.dish-name { font-size: 31rpx; font-weight: 600; color: #2E2822; }
.mini-tag {
  font-size: 20rpx;
  background: #F2ECE3;
  color: #8A7F71;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}
.suit {
  flex-shrink: 0;
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  margin-left: 16rpx;
}
.suit-best { background: #E4F0E7; color: #35704A; }
.suit-good { background: #EAF1E9; color: #4E7A56; }
.suit-normal { background: #FAF0DE; color: #93702C; }
.suit-avoid { background: #FAE7E3; color: #B24C3C; }

.dish-ing {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #6B6155;
  background: #F7F3EC;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  line-height: 1.65;
}
.dish-ing-label {
  display: inline-block;
  font-size: 20rpx;
  background: #E4DBCD;
  color: #7A6F62;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.dish-line {
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}
.dish-line.good { color: #3F7350; }
.dish-line.caution { color: #B24C3C; }

.dish-tip {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #8A7A5F;
  background: #FBF5E9;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  line-height: 1.65;
}

.dish-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EAE0;
}
.swap-btn {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #B85C38;
  border: 2rpx solid #E9D3C6;
  border-radius: 100rpx;
  padding: 8rpx 24rpx;
  margin-left: 14rpx;
}

/* 提醒 */
.note-card { padding: 24rpx 26rpx; }
.note-tip { font-size: 24rpx; color: #6B6155; margin-top: 8rpx; line-height: 1.65; }

.action-row { display: flex; margin-top: 34rpx; }
