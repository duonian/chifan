.head { padding: 16rpx 8rpx 24rpx; }

.member-card { position: relative; }
.cond-pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  font-size: 23rpx;
  margin: 0 12rpx 12rpx 0;
  font-weight: 500;
}
.link-btn {
  padding: 10rpx 30rpx;
  background: #F5F1EA;
  border-radius: 100rpx;
  font-size: 25rpx;
  margin-right: 18rpx;
  color: #6B6155;
}
.link-btn.warn { color: #C0504D; background: #FBEDEA; }

/* 弹层 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(35, 28, 22, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 88vh;
  background: #FBF8F3;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #EDE6DB;
}
.sheet-close { font-size: 36rpx; color: #A2988B; padding: 0 12rpx; }
.sheet-body { flex: 1; padding: 24rpx 32rpx; }
.sheet-foot {
  padding: 20rpx 32rpx 44rpx;
  border-top: 1rpx solid #EDE6DB;
  background: #FBF8F3;
}

.field { margin-bottom: 34rpx; }
.field-label { font-size: 27rpx; font-weight: 600; color: #3A342D; margin-bottom: 14rpx; }
.field-input {
  height: 84rpx;
  background: #fff;
  border: 1rpx solid #E7DFD3;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.field-textarea {
  width: 100%;
  height: 140rpx;
  background: #fff;
  border: 1rpx solid #E7DFD3;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.seg {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #E7DFD3;
  font-size: 28rpx;
  color: #7A6F62;
}
.seg:first-child { border-radius: 16rpx 0 0 16rpx; }
.seg:last-child { border-radius: 0 16rpx 16rpx 0; border-left: none; }
.seg.on { background: #B85C38; color: #fff; border-color: #B85C38; }

/* 症状选择 */
.cond-group {
  background: #fff;
  border: 1rpx solid #E7DFD3;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.cond-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  font-size: 27rpx;
}
.cond-list { border-top: 1rpx solid #F0EAE0; }
.cond-item {
  display: flex;
  align-items: center;
  padding: 6rpx 24rpx 6rpx 20rpx;
  border-bottom: 1rpx solid #F5F0E8;
}
.cond-item:last-child { border-bottom: none; }
.cond-check { display: flex; align-items: flex-start; flex: 1; padding: 16rpx 0; }
.cond-box {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid #D8CDBD;
  border-radius: 10rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  text-align: center;
  line-height: 38rpx;
  font-size: 26rpx;
  color: transparent;
  margin-top: 4rpx;
}
.cond-check.on .cond-box { background: #B85C38; border-color: #B85C38; color: #fff; }
.cond-name { font-size: 27rpx; color: #3A342D; font-weight: 500; }
.cond-check.on .cond-name { color: #B85C38; font-weight: 600; }
.cond-brief { font-size: 22rpx; color: #A2988B; margin-top: 4rpx; line-height: 1.5; }
.cond-info {
  padding: 12rpx 8rpx 12rpx 16rpx;
  color: #B0A697;
  font-size: 30rpx;
}

/* 症状详情弹窗 */
.cond-detail {
  position: fixed;
  left: 40rpx; right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 76vh;
  overflow-y: auto;
  background: #FFFDFA;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  z-index: 110;
}
.dl { font-size: 25rpx; font-weight: 600; color: #7A6F62; margin: 24rpx 0 12rpx; }
.dd { font-size: 26rpx; color: #4A443C; line-height: 1.75; }
