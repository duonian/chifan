/* ===== 我的 / 个人中心 ===== */

.me-head {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #B85C38, #9A4E2E);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(150, 80, 50, 0.18);
}
.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.me-info { flex: 1; min-width: 0; }
.me-name { font-size: 38rpx; font-weight: 700; color: #fff; }
.me-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.82); margin-top: 8rpx; }

/* 地区 chip（与首页同款） */
.region-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 100rpx;
  background: #F1EBE1;
  color: #7A6F62;
  font-size: 24rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid transparent;
}
.region-chip.on {
  background: #FBEBE2;
  color: #B85C38;
  border-color: #E0B79C;
  font-weight: 600;
}
.region-short {
  font-size: 20rpx;
  opacity: 0.7;
  margin-right: 6rpx;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F1EBE1;
  color: #B85C38;
  font-size: 38rpx;
  line-height: 60rpx;
  text-align: center;
  font-weight: 700;
}
.step-btn:active { background: #E4D6C8; }
.step-val {
  min-width: 84rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #2E2822;
}

/* 忌口 chips */
.exclude-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 100rpx;
  background: #FAE9E6;
  color: #B8503F;
  font-size: 25rpx;
  margin: 0 14rpx 14rpx 0;
}
.exclude-x { margin-left: 10rpx; font-weight: 700; opacity: 0.7; }

.add-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.add-input {
  flex: 1;
  height: 72rpx;
  background: #F5F1EA;
  border-radius: 100rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.suggest-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  background: #F1EBE1;
  color: #7A6F62;
  font-size: 23rpx;
  margin: 0 12rpx 12rpx 0;
}
.suggest-chip.on {
  background: #FAE9E6;
  color: #B8503F;
  text-decoration: line-through;
}

/* 菜单行 */
.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.menu-left { font-size: 30rpx; font-weight: 500; }
.menu-arrow { font-size: 26rpx; color: #B85C38; }

.foot-note {
  font-size: 22rpx;
  color: #B0A697;
  line-height: 1.7;
  padding: 16rpx 8rpx 0;
}
