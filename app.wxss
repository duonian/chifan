/* ===== 全局样式：温润的东方家常质感 ===== */
page {
  background: #F5F1EA;
  color: #3A342D;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ---- 卡片 ---- */
.card {
  background: #FFFDFA;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(120, 100, 80, 0.06);
}

.card-flat {
  background: #FFFDFA;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #EDE6DB;
}

/* ---- 文字 ---- */
.h1 { font-size: 42rpx; font-weight: 700; color: #2E2822; letter-spacing: 1rpx; }
.h2 { font-size: 34rpx; font-weight: 600; color: #2E2822; }
.h3 { font-size: 30rpx; font-weight: 600; color: #3A342D; }
.muted { color: #9A9086; font-size: 24rpx; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; }
.accent { color: #B85C38; }
.green { color: #4A7C59; }
.warn { color: #C0504D; }

/* ---- 区块标题 ---- */
.section-title {
  display: flex;
  align-items: center;
  margin: 32rpx 0 18rpx;
}
.section-title .bar {
  width: 8rpx;
  height: 30rpx;
  background: #B85C38;
  border-radius: 4rpx;
  margin-right: 14rpx;
}
.section-title .txt { font-size: 32rpx; font-weight: 600; }
.section-title .extra { margin-left: auto; font-size: 24rpx; color: #9A9086; }

/* ---- 标签 ---- */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  margin: 0 10rpx 10rpx 0;
  background: #F1EBE1;
  color: #7A6F62;
  line-height: 1.7;
}
.tag-good { background: #E7F0E8; color: #3F7350; }
.tag-bad { background: #FAE9E6; color: #B8503F; }
.tag-info { background: #E8EEF3; color: #4A6B85; }
.tag-warm { background: #FBEEDC; color: #9A6A28; }

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary { background: #B85C38; color: #fff; }
.btn-primary:active { background: #A04E2E; }
.btn-ghost { background: #FFFDFA; color: #B85C38; border: 2rpx solid #E4D6C8; }
.btn-block { width: 100%; }
.btn-sm { height: 62rpx; font-size: 26rpx; padding: 0 28rpx; display: inline-flex; }

/* ---- 分割 ---- */
.divider { height: 1rpx; background: #EDE6DB; margin: 20rpx 0; }

/* ---- 行 ---- */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.wrap { display: flex; flex-wrap: wrap; }

/* ---- 空状态 ---- */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #B0A697;
}
.empty .emoji { font-size: 80rpx; display: block; margin-bottom: 20rpx; }

/* ---- 头像 ---- */
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex-shrink: 0;
}
.avatar-male { background: linear-gradient(135deg, #6E8FA8, #4E6E88); }
.avatar-female { background: linear-gradient(135deg, #C88BA0, #A96A82); }
.avatar-sm { width: 52rpx; height: 52rpx; font-size: 22rpx; }

/* ---- 提示条 ---- */
.notice {
  background: #FBF3E6;
  border-left: 6rpx solid #D99441;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 25rpx;
  color: #7A5F32;
}
.notice-danger {
  background: #FBEDEA;
  border-left-color: #C0504D;
  color: #8C3A34;
}
.notice-ok {
  background: #EDF4EE;
  border-left-color: #4A7C59;
  color: #3A6146;
}
